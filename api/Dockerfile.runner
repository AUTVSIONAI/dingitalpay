FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

# Needed to run dingitalpay-updater from inside the container against the host Docker daemon.
# - docker + docker compose (v2) to manage the stack
# - bash + core tools used by dingitalpay-updater
RUN apk add --no-cache \
  bash \
  ca-certificates \
  coreutils \
  curl \
  grep \
  sed \
  tar \
  util-linux \
  docker-cli \
  docker-cli-compose

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

# Runs the platform worker loop (email outbox + optional updates runner).
CMD ["node", "dist/worker.js"]

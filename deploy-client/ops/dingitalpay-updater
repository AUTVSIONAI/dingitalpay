        umask 077
        {
          echo "previous=$PREV_LINK"
          echo "next=$RELEASE_DIR"
          echo "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        } > "$STATE_FILE" || true
      fi

      cd "$RELEASE_DIR/deploy"
      DC_ARGS=()
      if [ -n "$COMPOSE_PROJECT_NAME" ]; then
        DC_ARGS+=(--project-name "$COMPOSE_PROJECT_NAME")
      fi

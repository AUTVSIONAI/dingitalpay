        BACKUP_MODE="${UPDATER_BACKUP_MODE:-schema}" # none|schema|full
        BACKUP_KEEP="${UPDATER_BACKUP_KEEP:-10}" # number of snapshots to keep
        SNAPSHOT_ROOT="${BACKUP_DIR}/snapshots"
        mkdir -p "$SNAPSHOT_ROOT"
        TS="$(date -u +%Y%m%dT%H%M%SZ)"
        SNAPSHOT_DIR="${SNAPSHOT_ROOT}/${TS}"
        mkdir -p "$SNAPSHOT_DIR"
        if [ "$BACKUP_MODE" != "none" ]; then
          for DBNAME in "${DINGITALPAY_PROD_DB:-dingitalpay_prod}"; do
            (cd "$PREV_LINK/deploy" && docker compose --env-file "$ENV_FILE" -f compose.yml exec -T dingitalpay-postgres pg_dump --schema-only -U postgres "$DBNAME") > "${SNAPSHOT_DIR}/schema-${DBNAME}.sql" 2>/dev/null || true
            if [ "$BACKUP_MODE" = "full" ]; then
              (cd "$PREV_LINK/deploy" && docker compose --env-file "$ENV_FILE" -f compose.yml exec -T dingitalpay-postgres pg_dump -Fc -U postgres "$DBNAME") > "${SNAPSHOT_DIR}/full-${DBNAME}.dump" 2>/dev/null || true
            fi
          done
        fi
        # Retention (best-effort)
        if [ -n "$BACKUP_KEEP" ] && [ "$BACKUP_KEEP" -gt 0 ] 2>/dev/null; then
          ls -1t "$SNAPSHOT_ROOT" 2>/dev/null | awk "NR>${BACKUP_KEEP}" | xargs -r -I{} rm -rf "${SNAPSHOT_ROOT}/{}" 2>/dev/null || true
        fi
      fi

      mkdir -p "$RELEASE_DIR"

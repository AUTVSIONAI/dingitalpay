      updater_in_release=""
      if [ -f "$RELEASE_DIR/deploy/ops/dingitalpay-updater" ]; then
        updater_in_release="$RELEASE_DIR/deploy/ops/dingitalpay-updater"
      else
        candidate="$(ls -1 "$RELEASE_DIR/deploy/ops" 2>/dev/null | grep -E "updater$" | head -n1 || true)"
        if [ -n "$candidate" ]; then
          updater_in_release="$RELEASE_DIR/deploy/ops/$candidate"
        fi
      fi

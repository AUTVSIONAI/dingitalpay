      if grep -q "^UPDATES_RUNNER_BIN=/opt/dingitalpay/current/deploy/ops/.*updater$" "$ENV_FILE" 2>/dev/null; then
        sed -i "s|^UPDATES_RUNNER_BIN=/opt/dingitalpay/current/deploy/ops/.*updater$|UPDATES_RUNNER_BIN=/usr/local/bin/dingitalpay-updater|" "$ENV_FILE" || true
      fi
    fi

    # Persist state for rollback (simple k=v file; no external deps)
    if [ -n "$PREV_LINK" ]; then
      umask 077
      {
        echo "previous=$PREV_LINK"
        echo "next=$RELEASE_DIR"
        echo "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      } > "$STATE_FILE" || true
    fi

    cd "$RELEASE_DIR/deploy"
    DC_ARGS=()
    if [ -n "$COMPOSE_PROJECT_NAME" ]; then
      DC_ARGS+=(--project-name "$COMPOSE_PROJECT_NAME")
    fi
    PROFILE_ARGS=()
    if [ "${DEPLOY_USE_TLS_PROFILE:-false}" = "true" ]; then
      PROFILE_ARGS+=(--profile tls)
    fi
    if [ "${DEPLOY_USE_TLS_INTERNAL_PROFILE:-false}" = "true" ]; then
      PROFILE_ARGS+=(--profile tls-internal)
    fi
    if [ "${DEPLOY_USE_RUNNER_PROFILE:-false}" = "true" ]; then
      PROFILE_ARGS+=(--profile runner)
    fi
    log "APPLY: profiles tls=${DEPLOY_USE_TLS_PROFILE:-false} tls-internal=${DEPLOY_USE_TLS_INTERNAL_PROFILE:-false} runner=${DEPLOY_USE_RUNNER_PROFILE:-false}"

    # Run migrations explicitly (so new migration files are applied even if api/web does not restart).
    if ! docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --profile migrate --env-file "$ENV_FILE" -f compose.yml run --rm dingitalpay-migrate-prod; then
      fail "Falha ao aplicar migrations"
    fi
    if ! docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build; then
      if [ -n "$PREV_LINK" ] && [ -d "$PREV_LINK/deploy" ]; then
        (cd "$PREV_LINK/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build) || true
      fi
      fail "Falha ao aplicar update"
    fi
    docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --force-recreate dingitalpay-api-prod dingitalpay-web >/dev/null 2>&1 \
      || docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build dingitalpay-api-prod dingitalpay-web >/dev/null 2>&1 \
      || true

    for _i in $(seq 1 20); do
      if health_api; then
        break
      fi
      sleep 1
    done
    if ! health_api; then
      if [ -n "$PREV_LINK" ] && [ -d "$PREV_LINK/deploy" ]; then
        (cd "$PREV_LINK/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build) || true
        (cd "$PREV_LINK/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --force-recreate dingitalpay-api-prod dingitalpay-web) >/dev/null 2>&1 || true
      fi
      fail "Healthcheck falhou após update (/api/health)"
    fi
    if ! health_web; then
      if [ -n "$PREV_LINK" ] && [ -d "$PREV_LINK/deploy" ]; then
        (cd "$PREV_LINK/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build) || true
        (cd "$PREV_LINK/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --force-recreate dingitalpay-api-prod dingitalpay-web) >/dev/null 2>&1 || true
      fi
      fail "Healthcheck falhou após update (web /)"
    fi

    # Switch current only after a successful update + healthcheck (atomic pointer update).
    ln -sfn "$RELEASE_DIR" "$CURRENT_LINK"

    printf "%s update applied version=%s\\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$VERSION" >>"$LOG_FILE" || true
    log "OK"
  '
  fi

  append_log "apply ok version=${version}"
  log "OK: update aplicado (${version})"
}

rollback_update() {
  load_env
  resolve_deploy_profiles
  validate_deploy_profiles
  reconcile_disabled_proxy_services
  [ -f "$STATE_FILE" ] || fail "Sem estado de update anterior (arquivo não encontrado)."
  local prev=""
  prev="$(sed -n 's/^previous=//p' "$STATE_FILE" | head -n1 || true)"
  [ -n "$prev" ] || fail "Estado inválido (previous)."
  [ -d "$prev/deploy" ] || fail "Release anterior inválido: $prev"
  [ -f "$ENV_FILE" ] || fail "Config não encontrada: $ENV_FILE"
  ln -sfn "$prev" "${INSTALL_ROOT}/current"
  updater_in_prev=""
  if [ -f "$prev/deploy/ops/dingitalpay-updater" ]; then
    updater_in_prev="$prev/deploy/ops/dingitalpay-updater"
  else
    candidate="$(ls -1 "$prev/deploy/ops" 2>/dev/null | grep -E "updater$" | head -n1 || true)"
    if [ -n "$candidate" ]; then
      updater_in_prev="$prev/deploy/ops/$candidate"
    fi
  fi
  if [ -n "$updater_in_prev" ]; then
    install -m 755 "$updater_in_prev" /usr/local/bin/dingitalpay-updater >/dev/null 2>&1 || cp -f "$updater_in_prev" /usr/local/bin/dingitalpay-updater || true
    chmod 755 /usr/local/bin/dingitalpay-updater >/dev/null 2>&1 || true
  fi
  DC_ARGS=()
  if [ -n "${COMPOSE_PROJECT_NAME:-}" ]; then
    DC_ARGS+=(--project-name "${COMPOSE_PROJECT_NAME}")
  fi
  PROFILE_ARGS=()
  if [ "${DEPLOY_USE_TLS_PROFILE:-false}" = "true" ]; then
    PROFILE_ARGS+=(--profile tls)
  fi
  if [ "${DEPLOY_USE_TLS_INTERNAL_PROFILE:-false}" = "true" ]; then
    PROFILE_ARGS+=(--profile tls-internal)
  fi
  if [ "${DEPLOY_USE_RUNNER_PROFILE:-false}" = "true" ]; then
    PROFILE_ARGS+=(--profile runner)
  fi
  (cd "$prev/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build) || fail "Rollback falhou"
  (cd "$prev/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --force-recreate dingitalpay-api-prod dingitalpay-web) >/dev/null 2>&1 \
    || (cd "$prev/deploy" && docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build dingitalpay-api-prod dingitalpay-web) >/dev/null 2>&1 \
    || true
  append_log "rollback ok to=$(basename "$prev")"
  log "OK: rollback aplicado para $(basename "$prev")"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  configure)
    if [ "${1:-}" != "--token" ] || [ -z "${2:-}" ]; then
      fail "Uso: dingitalpay-updater configure --token SEU_TOKEN"
    fi
    configure_token "$2"
    ;;
  status)
    load_env
    v="$(current_version || true)"
    if get_token >/dev/null 2>&1; then
      log "token: configured"
    else
      log "token: not_configured"
    fi
    log "current: ${v:-unknown}"
    ;;
  check)
    check_updates
    ;;
  plan)
    if [ "${1:-}" != "--version" ] || [ -z "${2:-}" ]; then
      fail "Uso: dingitalpay-updater plan --version vX.Y.Z [--force]"
    fi
    force="false"
    if [ "${3:-}" = "--force" ]; then force="true"; fi
    plan_update "$2" "$force"
    ;;
  apply)
    if [ "${1:-}" != "--version" ] || [ -z "${2:-}" ]; then
      fail "Uso: dingitalpay-updater apply --version vX.Y.Z [--force]"
    fi
    force="false"
    if [ "${3:-}" = "--force" ]; then force="true"; fi
    apply_update "$2" "$force"
    ;;
  rollback)
    rollback_update
    ;;
  *)
    cat >&2 <<EOF
DingitalPay Updater

Usage:
  dingitalpay-updater configure --token SEU_TOKEN
  dingitalpay-updater status
  dingitalpay-updater check
  dingitalpay-updater plan --version vX.Y.Z [--force]
  dingitalpay-updater apply --version vX.Y.Z [--force]
  dingitalpay-updater rollback

Options:
  --install-root /opt/dingitalpay
  --product-key  dingitalpay-platform
EOF
    exit 2
    ;;
esac

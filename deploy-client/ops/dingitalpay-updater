        fi
        fail "Falha ao aplicar update"
	    fi

      docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --force-recreate dingitalpay-api-prod dingitalpay-web >/dev/null 2>&1 \
        || docker compose "${DC_ARGS[@]}" "${PROFILE_ARGS[@]}" --env-file "$ENV_FILE" -f compose.yml up -d --build dingitalpay-api-prod dingitalpay-web >/dev/null 2>&1 \
        || true
	
	    HC_TRIES="${UPDATER_HEALTHCHECK_TRIES:-120}"
	    HC_SLEEP="${UPDATER_HEALTHCHECK_SLEEP_SECONDS:-1}"
	
	    wait_for_api_health() {
	      for _i in $(seq 1 "$HC_TRIES"); do
	        if health_api; then
	          return 0
	        fi
	        sleep "$HC_SLEEP"
	      done
	      return 1
	    }
	
	    wait_for_web_root() {
